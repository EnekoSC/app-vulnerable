# distribuciones santa s.l. - entorno de laboratorio
# no exponer a internet

APP_NAME="Distribuciones Santa S.L."

APP_ENV=local
APP_DEBUG=true

APP_KEY=
APP_TIMEZONE=Europe/Madrid
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# base de datos (servicio db del compose)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=santasl
DB_USERNAME=santasl
DB_PASSWORD=santasl

# sesion en bd
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@santasl.local"
MAIL_FROM_NAME="${APP_NAME}"
